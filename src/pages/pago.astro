---
export const prerender = false

import crypto from 'node:crypto'
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import CTA from '../components/CTA.astro'
import Footer from '../components/Footer.astro'

// Token que debe llevar el QR: /pago?token=ESTE_VALOR
// Se toma de la variable de entorno PAYMENT_TOKEN (configúrala en Vercel).
// El valor de respaldo solo aplica si no está definida (p. ej. en local sin .env).
const PAYMENT_TOKEN = import.meta.env.PAYMENT_TOKEN || 'GAMA-PAGO-7F3K9Q2X'

const SESSION_COOKIE = 'gama_pago_session'
const SESSION_MS = 30 * 60 * 1000

function sign(value) {
  return crypto.createHmac('sha256', PAYMENT_TOKEN).update(value).digest('hex')
}

function readSessionExpiry(cookieValue) {
  if (!cookieValue) return null
  const [expiresAtRaw, signature] = cookieValue.split('.')
  if (!expiresAtRaw || !signature || sign(expiresAtRaw) !== signature) return null
  const expiresAt = Number(expiresAtRaw)
  if (!Number.isFinite(expiresAt) || expiresAt <= Date.now()) return null
  return expiresAt
}

// Estas páginas nunca deben cachearse (ni en el navegador ni en el edge de Vercel):
// contienen datos bancarios y su acceso depende de una cookie de sesión.
Astro.response.headers.set('Cache-Control', 'no-store')

const token = Astro.url.searchParams.get('token')
let sessionExpiresAt

if (token) {
  if (token !== PAYMENT_TOKEN) {
    return Astro.redirect('/')
  }

  sessionExpiresAt = Date.now() + SESSION_MS
  Astro.cookies.set(SESSION_COOKIE, `${sessionExpiresAt}.${sign(String(sessionExpiresAt))}`, {
    path: '/pago',
    maxAge: SESSION_MS / 1000,
    httpOnly: true,
    sameSite: 'lax',
    secure: import.meta.env.PROD,
  })

  // Redirige a la URL limpia: esta respuesta con el token en query nunca llega a
  // renderizar los datos, así no queda expuesta ni cacheada en ningún lado.
  return Astro.redirect(Astro.url.pathname)
}

sessionExpiresAt = readSessionExpiry(Astro.cookies.get(SESSION_COOKIE)?.value)

if (!sessionExpiresAt) {
  return Astro.redirect('/')
}

const paymentFields = [
  {
    id: 'beneficiario',
    label: 'Beneficiario',
    value: 'MARIA DE LOURDES MARTINEZ GODINEZ',
    mono: false,
  },
  {
    id: 'clabe',
    label: 'CLABE interbancaria',
    value: '638180010172678228',
    mono: true,
  },
  {
    id: 'banco',
    label: 'Banco',
    value: 'Nu México',
    mono: false,
  },
]

const storeCode = {
  id: 'codigo',
  label: 'Código para depósito en tienda',
  value: '5101 2564 8805 4172',
  mono: true,
}

const stores = ['OXXO', 'Soriana', 'Kiosko', 'Chedraui', 'Farmacias del Ahorro', "Waldo's"]
---

<Layout title="Datos de pago | Cerrajería GAMA Express" noindex>
  <Nav />

  <main class="min-h-[70vh] bg-surface py-14 sm:py-20 px-5 sm:px-8">
    <div id="pago-app" class="max-w-md mx-auto">
      <div class="relative bg-navy rounded-3xl p-6 sm:p-8 text-center overflow-hidden mb-8">
        <div class="absolute inset-0 bg-hero-glow pointer-events-none opacity-70" aria-hidden="true"></div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-40 h-px bg-gradient-to-r from-transparent via-brand/70 to-transparent" aria-hidden="true"></div>

        <div class="relative">
          <div class="inline-flex items-center justify-center p-4 rounded-2xl bg-brand/20 border border-brand/30 mb-4 mx-auto">
            <svg class="w-7 h-7 text-brand" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75Z" />
            </svg>
          </div>

          <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-white leading-tight mb-2">
            Datos de pago
          </h1>
          <p class="text-gray-300 text-sm font-medium max-w-xs mx-auto">
            Toca el ícono de cada campo para copiarlo. Esta información es solo para ti, no la compartas.
          </p>
        </div>
      </div>

      <div class="bg-white border border-border rounded-3xl p-5 sm:p-6 shadow-sm">
        <div class="flex flex-col gap-4">
          {paymentFields.map((f) => (
            <div>
              <label for={f.id} class="block text-gray-500 text-xs font-bold uppercase tracking-wide mb-1.5">
                {f.label}
              </label>
              <div class="relative">
                <input
                  id={f.id}
                  type="text"
                  inputmode="none"
                  readonly
                  value={f.value}
                  class:list={[
                    'w-full bg-surface border border-border rounded-xl pl-4 pr-12 py-3 text-gray-900 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand/40',
                    { 'font-mono tracking-wide': f.mono },
                  ]}
                />
                <button
                  type="button"
                  data-copy-target={f.id}
                  aria-label={`Copiar ${f.label}`}
                  class="copy-btn absolute right-1.5 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-9 h-9 rounded-lg text-gray-500 hover:text-navy hover:bg-black/5 transition-all active:scale-95"
                >
                  <svg class="copy-icon w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
                  </svg>
                  <svg class="check-icon w-5 h-5 hidden text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                </button>
              </div>
            </div>
          ))}
        </div>

        <!-- Divider -->
        <div class="flex items-center gap-3 my-5" aria-hidden="true">
          <div class="flex-1 h-px bg-border"></div>
          <span class="text-gray-400 text-xs font-bold uppercase tracking-widest shrink-0">O en tiendas</span>
          <div class="flex-1 h-px bg-border"></div>
        </div>

        <!-- Alternativa: pago en tienda -->
        <div class="rounded-2xl bg-amber-50 border border-amber-200 p-4 sm:p-5">
          <div class="flex items-start gap-3 mb-4">
            <div class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-xl bg-brand/25 text-amber-700">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349M3.75 9.35a2.626 2.626 0 0 0 3.75-1.03 2.625 2.625 0 0 0 4.5 0 2.625 2.625 0 0 0 4.5 0 2.626 2.626 0 0 0 3.75 1.03M4.5 3h15l1.5 6.354a1.125 1.125 0 0 1-.53.995A2.625 2.625 0 0 1 18 9.35c-.98 0-1.813-.62-2.13-1.492a.375.375 0 0 0-.706 0A2.25 2.25 0 0 1 12.75 9.35a2.25 2.25 0 0 1-2.414-1.492.375.375 0 0 0-.706 0A2.25 2.25 0 0 1 7.5 9.35a2.625 2.625 0 0 1-1.977.995 2.625 2.625 0 0 1-2.023-.995A1.125 1.125 0 0 1 3 9.35L4.5 3Z" />
              </svg>
            </div>
            <div>
              <p class="text-gray-900 font-heading font-bold text-sm mb-0.5">¿Prefieres pagar en efectivo?</p>
              <p class="text-gray-600 text-xs leading-relaxed font-medium">
                Da este código en la caja de cualquiera de estas tiendas, sin necesidad de tarjeta ni cuenta bancaria.
              </p>
            </div>
          </div>

          <div class="mb-4">
            <label for={storeCode.id} class="block text-gray-500 text-xs font-bold uppercase tracking-wide mb-1.5">
              {storeCode.label}
            </label>
            <div class="relative">
              <input
                id={storeCode.id}
                type="text"
                inputmode="none"
                readonly
                value={storeCode.value}
                class="w-full bg-white border border-amber-200 rounded-xl pl-4 pr-12 py-3 text-gray-900 text-sm font-semibold font-mono tracking-wide focus:outline-none focus:ring-2 focus:ring-brand/40"
              />
              <button
                type="button"
                data-copy-target={storeCode.id}
                aria-label={`Copiar ${storeCode.label}`}
                class="copy-btn absolute right-1.5 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-9 h-9 rounded-lg text-gray-500 hover:text-navy hover:bg-black/5 transition-all active:scale-95"
              >
                <svg class="copy-icon w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
                </svg>
                <svg class="check-icon w-5 h-5 hidden text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
              </button>
            </div>
          </div>

          <p class="text-gray-500 text-xs font-bold uppercase tracking-wide mb-2">Tiendas participantes</p>
          <div class="flex flex-wrap gap-1.5">
            {stores.map((s) => (
              <span class="text-xs font-semibold text-gray-700 bg-white border border-amber-200 rounded-full px-3 py-1">
                {s}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </main>

  <CTA />

  <Footer />

  <script define:vars={{ sessionExpiresAt }}>
    (function () {
      // El servidor ya validó el acceso; esto solo agenda la salida cuando
      // la sesión caduque mientras la pestaña sigue abierta.
      var remaining = sessionExpiresAt - Date.now()
      window.setTimeout(function () {
        window.location.replace('/')
      }, Math.max(remaining, 0))
    })()
  </script>

  <script>
    document.querySelectorAll('.copy-btn').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        var targetId = btn.getAttribute('data-copy-target')
        var input = document.getElementById(targetId)
        if (!input) return

        try {
          await navigator.clipboard.writeText(input.value)
        } catch (e) {
          input.removeAttribute('readonly')
          input.select()
          document.execCommand('copy')
          input.setAttribute('readonly', '')
        }

        var copyIcon = btn.querySelector('.copy-icon')
        var checkIcon = btn.querySelector('.check-icon')
        copyIcon.classList.add('hidden')
        checkIcon.classList.remove('hidden')

        window.setTimeout(function () {
          copyIcon.classList.remove('hidden')
          checkIcon.classList.add('hidden')
        }, 1500)
      })
    })
  </script>
</Layout>
